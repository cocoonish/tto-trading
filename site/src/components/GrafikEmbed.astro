---
/**
 * Python projelerinin ürettiği interaktif (Plotly vb.) HTML çıktısını
 * makale içine gömer. Dosyalar site/public/ altında durur;
 * güncelleme akışı yeni HTML'i aynı yola kopyalayınca grafik de yenilenir.
 */
interface Props {
  src: string; // ör. /projeler/tcmb-net-rezerv/grafik.html
  baslik: string;
  no?: string; // ör. "01"
  yukseklik?: number;
}

const { src, baslik, no, yukseklik = 540 } = Astro.props;
---

<figure class="grafik">
  <figcaption>
    <span class="etiket grafik-no">{no ? `Şekil ${no}` : 'Şekil'}</span>
    <span class="grafik-baslik">{baslik}</span>
    <a class="etiket tam-ekran" href={src} target="_blank" rel="noopener">Tam ekran ↗</a>
  </figcaption>
  <iframe src={src} title={baslik} loading="lazy" style={`height:${yukseklik}px`}></iframe>
</figure>

<style>
  .grafik {
    margin: 2.2em 0;
    border: 1px solid var(--ink-30);
    background: #fff;
  }
  figcaption {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--ink-15);
    background: var(--paper-2);
  }
  .grafik-no {
    color: var(--claret);
  }
  .grafik-baslik {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-70);
  }
  .tam-ekran {
    margin-left: auto;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-50);
  }
  .tam-ekran:hover {
    color: var(--claret);
  }
  iframe {
    display: block;
    width: 100%;
    border: none;
  }
</style>
