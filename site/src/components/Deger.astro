---
/**
 * Canlı metin değeri: proje pipeline'ının yazdığı ozet.json'dan okunur.
 * Kullanım: <Deger proje="hazine-ihrac" anahtar="gerceklesme_ort" ondalik={1}>85,7</Deger>
 * Slot içeriği statik yedektir (JSON yüklenemezse veya derleme anında görünür);
 * sayfa açılınca /projeler/<proje>/ozet.json çekilir ve tüm değerler güncellenir.
 * Böylece sayfa metnindeki sayılar, veri güncellendikçe MDX'e dokunmadan tazelenir.
 */
interface Props {
  proje: string;
  anahtar: string;
  ondalik?: number;
}
const { proje, anahtar, ondalik = 1 } = Astro.props;
---

<span
  class="canli-deger"
  data-proje={proje}
  data-anahtar={anahtar}
  data-ondalik={ondalik}><slot>…</slot></span>

<script>
  // Sayfa başına tek sefer: span'ları projeye göre grupla, ozet.json'ları çek, doldur.
  const alanlar = [...document.querySelectorAll('span.canli-deger')] as HTMLElement[];
  const projeler = [...new Set(alanlar.map((a) => a.dataset.proje!))];

  const bicimle = (v: unknown, ondalik: number) => {
    if (typeof v === 'number')
      return v.toLocaleString('tr-TR', {
        minimumFractionDigits: ondalik,
        maximumFractionDigits: ondalik,
      });
    return String(v);
  };

  projeler.forEach(async (proje) => {
    try {
      const r = await fetch(`/projeler/${proje}/ozet.json`, { cache: 'no-cache' });
      if (!r.ok) return;
      const ozet = await r.json();
      alanlar
        .filter((a) => a.dataset.proje === proje)
        .forEach((a) => {
          const v = ozet[a.dataset.anahtar!];
          if (v === undefined || v === null) return;
          a.textContent = bicimle(v, parseInt(a.dataset.ondalik || '1'));
          if (ozet._tarih) a.title = `canlı değer · veri: ${ozet._tarih}`;
          a.classList.add('yuklendi');
        });
    } catch {
      /* statik yedek metin kalır */
    }
  });
</script>

<style>
  .canli-deger {
    font-variant-numeric: tabular-nums;
    border-bottom: 1px dotted var(--ink-30);
    cursor: help;
  }
  .canli-deger.yuklendi {
    border-bottom-color: color-mix(in srgb, var(--teal) 55%, transparent);
  }
</style>
