    font-size: 0.88rem; color: var(--claret); font-variant: small-caps;
    letter-spacing: 0.07em; margin: 0 0 0.4rem;
  }
  .p-kaydir { overflow-x: auto; position: relative; }
  /* Klavyeyle gezen okur kayan tablonun gizli sütunlarına ulaşabilsin
     (WCAG 2.1.1): kap odak alır, odak halkası markanın bordosu. */
  .p-kaydir:focus-visible { outline: 2px solid var(--claret); outline-offset: 2px; }
  /* PİYASA TABLOLARI ALT ALTA HİZALI: on iki grup on iki ayrı tablo ve her
     biri sütun genişliğini kendi içeriğinden kuruyordu — aynı sütun gruptan
     gruba 60 piksele kadar kayıyordu. Sabit düzen, sütunları bütün gruplarda
     aynı x'e koyar; dar ekranda tablo en az 44rem kalır ve yatay kayar, ad
     sütunu yapışık durur. */
  table.p-piyasa { table-layout: fixed; min-width: 44rem; }
  table.p-piyasa col.c-ad { width: 30%; }
  table.p-piyasa col.c-son { width: 13%; }
  table.p-piyasa col.c-deg { width: 10.5%; }
  table.p-piyasa col.c-konum { width: 7.5%; }
  table.p-piyasa col.c-sigma { width: 7.5%; }
  table.p-piyasa td.p-ad { min-width: 0; overflow-wrap: break-word; }
  /* Tema tabloları dört sütun: telefonda da sığmalı. Piyasa tablolarının
     12rem'lik ad sütunu burada 'yılbaşından' sütununu yarısından kesiyordu. */
  table.p-tema td.p-ad { min-width: 0; white-space: normal; }
  @media (max-width: 640px) {
    table.p-tema th, table.p-tema td { padding-right: 0.35rem; }
  }
  @media (max-width: 760px) {
    table.p-piyasa th:first-child, table.p-piyasa td.p-ad {
      position: sticky; left: 0; z-index: 1; background: var(--paper);
      box-shadow: 1px 0 0 var(--ink-15);
    }
  }
  table.p-tablo { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
  /* BAŞLIKTA BÜYÜK HARF DÖNÜŞÜMÜ YOK: `text-transform: uppercase` küçük sigmayı
     (σ, standart sapma) büyük Sigma'ya (Σ, toplam) çeviriyordu — "1 GÜN Σ",
     "KAÇ Σ". Nicel okur için bu başka bir büyüklüğün adıdır. */
  table.p-tablo th {
    text-align: left; font-weight: 600; font-size: 0.74rem; color: var(--ink-70);
    letter-spacing: 0.01em; padding: 0 0.5rem 0.3rem 0;
    border-bottom: 1px solid var(--ink); vertical-align: bottom;
  }
  table.p-tablo th abbr { text-decoration: none; cursor: help; border-bottom: 1px dotted var(--ink-50); }
  table.p-tablo th.sag, table.p-tablo td.sag { text-align: right; }
  table.p-tablo td {
    padding: 0.34rem 0.5rem 0.34rem 0; border-bottom: 1px solid var(--ink-30);
    vertical-align: top; white-space: nowrap;
  }
  .p-ad { white-space: normal; min-width: 12rem; }
  .p-not { display: block; font-size: 0.7rem; color: var(--ink-70); font-style: italic; white-space: normal; }
  .p-tarih-ic, .p-tarih { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-60); }
  .p-tarih-ic { display: block; }
  .p-son { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .p-birim { font-size: 0.68em; color: var(--ink-70); margin-left: 0.25em; }
  .p-degisim { font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink-70); }
  .p-degisim.arti { color: var(--pozitif); }
  .p-degisim.eksi { color: var(--claret); }
  .p-aralik { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-60); }
  table.p-tablo.tl td:first-child { min-width: 16rem; }
  tr.gecersiz .p-son { color: var(--ink-70); }
  .p-bayrak {
    display: inline-block; margin-left: 0.4rem; font-family: var(--font-mono);
    font-size: 0.62rem; color: var(--uyari); border: 1px solid var(--uyari); padding: 0 0.28rem;
  }


  .temalar .alt-not { font-size: 0.8rem; color: var(--ink-70); margin: -0.3rem 0 1.1rem; }
  .tema { margin: 1.5rem 0; padding-left: 1rem; border-left: 3px solid var(--ink-30); }
  .tema.aktif { border-left-color: var(--claret); }
  .tema.izlemede { border-left-color: var(--uyari); }
  .tema h3 { font-size: 1rem; margin: 0 0 0.4rem; display: flex; gap: 0.6rem; align-items: baseline; }
  .tema-durum {
    font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--ink-70); border: 1px solid var(--ink-30);
    padding: 0.02rem 0.34rem;
  }
  .tema-gelisme {
    border-left: 2px solid var(--claret); padding: 0.5rem 0 0.5rem 0.8rem;
    margin: 0 0 0.7rem; background: color-mix(in srgb, var(--claret) 4%, transparent);
  }
  .tema-gelisme .etiket { display: block; color: var(--claret); margin-bottom: 0.25rem; }
  .tema-gelisme p { margin: 0 0 0.4rem; line-height: 1.55; }
  .tema-tez { margin: 0 0 0.5rem; line-height: 1.5; font-size: 0.92rem; }
  .tema-gozlem { margin: 0 0 0.6rem; font-size: 0.85rem; color: var(--ink-70); }
  .tema-isaret { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); gap: 0.9rem; margin: 0.8rem 0 0.4rem; }
  .isaret-baslik { font-variant: small-caps; letter-spacing: 0.06em; font-size: 0.78rem; color: var(--claret); }
  .tema-isaret ul { margin: 0.2rem 0 0; padding-left: 1.1rem; }
  .tema-isaret li { font-size: 0.82rem; line-height: 1.4; color: var(--ink-70); }
  .tema-gosterge { font-size: 0.85rem; margin: 0.5rem 0 0; }

  .kunye { border-top: 1px solid var(--ink-30); padding-top: 0.9rem; margin-top: 2.6rem; }
  .kunye p { font-size: 0.76rem; color: var(--ink-70); margin: 0 0 0.35rem; }
  .feragat { font-style: italic; }
  .gorunmez { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<style>
  /* İçindekiler: bülten uzun ve okur çoğu sabah tek bir bölümü arıyor.
     Bağlantılar yalnız GERÇEKTEN basılan bölümleri gösterir.

     Dar ekranda (<1200 px) üstte YAPIŞIK, yatay kayan bir bölüm şeridi:
     65 bin piksellik sayfada tek gezinme aracı en üstteki kutuydu ve
     kaydırınca kayboluyordu. */
  .icindekiler {
    position: sticky; top: 0; z-index: 5;
    margin: 1.4rem 0 0;
    padding: 0.5rem 0;
    background: var(--paper);
    border-top: 1px solid var(--ink-30);
    border-bottom: 1px solid var(--ink-30);
    overflow-x: auto;
    scrollbar-width: thin;
    counter-reset: ic;
  }
  .ic-baslik {
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--ink-60); margin: 0 0 0.55rem;
    display: none;
  }
  .icindekiler ol {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: nowrap; gap: 0.3rem 1.1rem; white-space: nowrap;
  }
  .icindekiler li { counter-increment: ic; }
  .icindekiler li::before {
    content: counter(ic) " ";
    font-family: var(--font-mono); font-size: 0.66rem; color: var(--ink-60);
  }
  .icindekiler a {
    font-family: var(--font-mono); font-size: 0.8rem;
    text-decoration: none; border-bottom: 1px solid transparent;
  }
  .icindekiler a:hover { border-bottom-color: var(--claret); color: var(--claret); }
  .icindekiler a[aria-current='true'] { color: var(--claret); border-bottom-color: var(--claret); }

  /* Çıpayla gelince başlık yapışık şeridin altında kalmasın. */
  .bulten section[id] { scroll-margin-top: 3.6rem; }

  /* Geniş ekran: ana sütun tabloların sığacağı genişlikte (46rem), sağda
     yapışık bir içindekiler sütunu. */
  @media (min-width: 1200px) {
    .bulten { max-width: none; }
    .ust { max-width: 46rem; }
    .bulten-izgara {
      display: grid;
      /* Sabit 46rem: minmax(0, 46rem) ile birlikte bir fr sütunu varken ilk
         sütun içeriğinin en geniş satırına (32rem'lik düzyazı) büzülüyor,
         boşluğu yan sütun alıyordu. */
      grid-template-columns: 46rem minmax(11rem, 1fr);
      gap: 0 3rem;
      align-items: start;
    }
    .bulten-govde { grid-column: 1; grid-row: 1; min-width: 0; }
    .icindekiler {
      grid-column: 2; grid-row: 1;
      top: 1.2rem; margin: 1.8rem 0 0;
      max-height: calc(100vh - 2.4rem); overflow-y: auto; overflow-x: visible;
      padding: 0 0 0 1rem;
      border: 0; border-left: 1px solid var(--ink-30);
      background: none;
    }
    .ic-baslik { display: block; }
    .icindekiler ol { flex-direction: column; flex-wrap: nowrap; gap: 0.45rem; white-space: normal; }
    .icindekiler li { line-height: 1.3; }
    .icindekiler a { font-size: 0.78rem; line-height: 1.3; }
    .bulten section[id] { scroll-margin-top: 1.5rem; }
  }
</style>

<script>
  // Etkin bölüm: üst kenarı ekranın üst dörtte birini geçmiş SON bölüm.
  // Kütüphane yok; bölüm sayısı on beşi geçmez.
  const baglar = [...document.querySelectorAll<HTMLAnchorElement>('.icindekiler a')];
  const hedefler = baglar
    .map((a) => ({ a, el: document.getElementById(a.hash.slice(1)) }))
    .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => !!x.el);
  let bekliyor = false;
  const isaretle = () => {
    bekliyor = false;
    const sinir = window.innerHeight * 0.25;
    let etkin: HTMLAnchorElement | null = null;
    for (const { a, el } of hedefler) if (el.getBoundingClientRect().top <= sinir) etkin = a;
    for (const { a } of hedefler) {
      if (a === etkin) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
    // Dar ekranda yatay şerit etkin bağlantıyı görünür tutar.
    if (etkin && window.innerWidth < 1200) {
      const nav = etkin.closest('.icindekiler') as HTMLElement | null;
      if (nav) {
        const l = etkin.offsetLeft, r = l + etkin.offsetWidth;
        if (l < nav.scrollLeft || r > nav.scrollLeft + nav.clientWidth) nav.scrollLeft = l - 16;
      }
    }
  };
  if (hedefler.length) {
    window.addEventListener('scroll', () => {
      if (!bekliyor) { bekliyor = true; requestAnimationFrame(isaretle); }
    }, { passive: true });
    isaretle();
  }
</script>
