---
/**
 * Günlük bültenin gövdesi. Veri, bulten/uret.py'nin yazdığı JSON'dan gelir
 * (site/src/data/bulten/YYYY-MM-DD.json) ve DERLEME sırasında okunur — sayfada
 * istemci tarafı veri çekme yoktur, bülten statik ve arşivlenebilir.
 *
 * Bölüm sırası bilinçli ve içindekiler (`bolumler`) aynı sıradan kurulur:
 * düzeltmeler → ne oldu / ne bekleniyor → gösterge şeridi → bugünün takvimi →
 * günün okuması → rejim → olağandışı hareketler → sonuçlar → piyasa fotoğrafı →
 * hat hat değişim → söz defteri → takvim → temalar → gündem → veri günlüğü →
 * kapsam notu. Sabah beş dakikada bakan biri ilk dört bölümden "ne değişti, ne
 * önemli, bugün ne var" sorularının cevabını almalı; derinlik aşağıda.
 */
import EgriGrafik from './EgriGrafik.astro';
import SigmaSerit from './SigmaSerit.astro';
import Kunye from './Kunye.astro';
import RejimSerit from './RejimSerit.astro';
import { OLAGANDISI_SIGMA, sigmaBasligi } from '../lib/anaSayfa';
import { sayi, yuzde, degisim, ondalikSay, istanbulSaat, tarihUzun, tarihYaz, gunAdi, duzMetin } from '../lib/bicim';
import type { BultenKaydi } from '../lib/yayinlar';
import { FERAGAT } from '../consts';
import type { HatSayfa } from '../lib/hatSayfa';

interface Props {
  b: any;
  /** Sayı numarası, ölçüm saati, sayımlar — lib/yayinlar.ts kaydı. */
  kayit?: BultenKaydi;
  /** Hat slug'ı → okura görünen ad ve sayfası (lib/hatSayfa). */
  hatSayfa?: Record<string, HatSayfa>;
  /** Bir önceki yazılmış sayının verisi: rejim panosunda fark için. */
  oncekiB?: any;
  /** Aynı gün yayımlanan öbür yayınlar (analiz, teknik sayı). */
  ayniGun?: { tur: string; ad: string; href: string }[];
}
const { b: ham, kayit, hatSayfa = {}, oncekiB = null, ayniGun = [] } = Astro.props;
// ŞEMA TEK YERDE TOPARLANIR: eksik bir liste bütün /bulten/* sayfalarını ve ana
// sayfayı düşürüp sitenin tamamının yayınını durdururdu. Yokluk boş listedir;
// bölüm başlıkları zaten 'liste doluysa' koşuluyla basılır.
const b: any = {
  gostergeler: [], rejim: [], one_cikanlar: [], sonuclar: [], gruplar: [], veri_gunlugu: [],
  ...(ham ?? {}),
  piyasa: { gruplar: [], turetilmis: [], tr_faizleri: [], ...(ham?.piyasa ?? {}),
            en_cok_hareket: { sigma: [], ...(ham?.piyasa?.en_cok_hareket ?? {}) } },
  haberler: { bolumler: [], okunamayan: [], ...(ham?.haberler ?? {}) },
  izleme: { acik: [], kapanan: [], karne: {}, ...(ham?.izleme ?? {}) },
};
// AD ve BAĞ ayrı çözülür ve ikisinin de son çaresi farklı. Ad: pano başlığı →
// kaydın kendi `hat_ad`ı (ölçüm katmanı, bulten/ayar.HAT_ADI) → slug. Bağ:
// sayfası varsa bağ, YOKSA HİÇ — panosu olmayan bir hat için `/projeler/<slug>/`
// yazmak okura 404 verirdi ve koşu yeşil biterdi.
const ad = (o: any) => hatSayfa[o?.hat]?.ad || o?.hat_ad || o?.hat || '';
const sayfa = (o: any) => hatSayfa[o?.hat]?.href ?? null;
// YAZI KATMANININ METİN SÖZLEŞMESİ: alanlar HTML taşır. `yorum`, `gundem.*`
// ve teknikteki `giris` zaten `set:html` ile basılıyordu; `ozet` ise metin
// olarak basılıyor ve yazarın koyduğu <p> okura ETİKET OLARAK görünüyordu
// (dört sayıda, yirmi kaçış). Tek alanı sözleşmenin dışında bırakmak, yazarın
// hangi alanda hangi dili yazacağını bilmesini gerektirir — bilemez.
//
// Düz metin de kabul: etiketle açılmayan bir değer <p> ile sarılır, yani
// sözleşme iki yönde de bozulmaz. Kaynak yazı katmanının kendi dosyasıdır
// (yaz.py kapısından geçer), okur girdisi değil.
// İŞARETLİ SAYI SATIRDA BÖLÜNMEZ. Eksi ile yüzde arasında satır kırılıyordu
// ("WTI −" satır sonunda, "%3,48" alt satırda). Basımda çözülür, veride değil:
// görünmez bir bağlayıcı karakter tweete, aramaya ve kopyalanan metne de
// giderdi. Yalnız metin düğümleri taranır; etiketlere dokunulmaz.
const sayiBag = (html: string): string =>
  html.split(/(<[^>]+>)/).map((parca) => (parca.startsWith('<')
    ? parca
    : parca.replace(/(?<![\p{L}\p{N}])([+−-]%?\d[\d.,]*%?|%\d[\d.,]*)/gu, '<span class="nb">$1</span>'))).join('');
const yaziMetni = (m: unknown) => {
  const t = String(m ?? '').trim();
  return sayiBag(t.startsWith('<') ? t : `<p>${t}</p>`);
};
// SÖZ DEFTERİ HER SABAH BAŞTAN ANLATILMAZ. Ölçüldü (07.09.2026, 13 sayı):
// bültenin düzyazısı günden güne tekrar etmiyor (gündem %0,6 · yorum %0,3),
// ama söz defteri ardışık iki sayı arasında %91,4 birebir örtüşüyordu —
// 4.816 sözcüklük bölüm her gün kelimesi kelimesine yeniden basılıyordu.
// Ölçüm katmanı artık her kaydı `degisti`/`duran` diye işaretliyor; sayfa
// değişeni TAM metniyle, duranı tek satırlık künyesiyle basar. Kayıt
// silinmiyor: duran bir sözün tam metni onu son değiştiren sayıda duruyor.
// Rejim satırlarına bir önceki sayının değeri eklenir (aynı ad); önceki sayı
// ya da satır yoksa fark basılmaz.
const oncekiRejim = new Map<string, number>(
  (Array.isArray(oncekiB?.rejim) ? oncekiB.rejim : [])
    .filter((r: any) => r && typeof r.deger === 'number')
    .map((r: any) => [String(r.ad), r.deger as number] as [string, number]),
);
const rejimSatirlari = (b.rejim ?? []).map((r: any) => ({
  ...r,
  hesap: r.hesap ?? '', etiket: r.etiket ?? '', aciklama: r.aciklama ?? '', konum: r.konum ?? '',
  onceki: oncekiRejim.has(String(r.ad)) ? oncekiRejim.get(String(r.ad)) : undefined,
}));
const sozKayitlari = [...(b.izleme.acik ?? []), ...(b.izleme.kapanan ?? [])];
// GERİYE DÖNÜK EMNİYET: ölçüm katmanı bu alanı yazmadan önce yayımlanmış
// sayılarda `degisti` YOK. O sayılarda ayrım KOŞMAMIŞTIR ve hepsini "duran"
// sayıp tek satıra indirmek, yayımlanmış bir metni sonradan kırpmak olurdu —
// okur o sayıyı tam hâliyle okumuştu. Alanı hiç taşımayan bir defterde bütün
// kayıtlar tam metinle basılır.
const sozAyrimVar = sozKayitlari.some((k: any) => k && 'degisti' in k);
const sozDegisen = sozAyrimVar ? sozKayitlari.filter((k: any) => k?.degisti) : sozKayitlari;
const sozDuran = sozAyrimVar ? sozKayitlari.filter((k: any) => !k?.degisti) : [];
const sozVade = (k: any) =>
  k.durum === 'kapandi' ? (k.isabet || 'kapandı')
  : k.gun_kalan === null ? 'vadesiz'
  : k.gun_kalan < 0 ? `${-k.gun_kalan} gün gecikti`
  : k.gun_kalan === 0 ? 'bugün'
  : `${k.gun_kalan} gün`;
const tz = (t: unknown) => (typeof t === 'string' ? tarihYaz(t) : '');
// HABER KAYNAĞI OKURA YAYINCIYLA YAZILIR. Haber taramasının arama akışından
// gelen maddelerde kaynak alanı iç sorgunun adını taşıyor ("Arama — Fed ve
// ECB") ve yayıncı başlığın sonuna ekleniyordu ("… - Reuters"); okur hem veri
// hattının iç yapısını hem de iki kez kaynak görüyordu. Yayıncı başlık
// sonekinden ayrılır; ayrılamazsa kaynak "haber taraması" yazılır.
const haberAyir = (m: any): { baslik: string; kaynak: string; lang?: string } => {
  const k = String(m?.kaynak ?? '');
  const t = String(m?.baslik ?? '');
  const ek = k.match(/\s*\(\+\d+ kaynak\)$/)?.[0] ?? '';
  let baslik = t, kaynak = k;
  const mm = t.match(/^(.*\S)\s+[-–—]\s+([^-–—]{2,60})$/);
  if (k.startsWith('Arama')) {
    baslik = mm ? mm[1] : t;
    kaynak = (mm ? mm[2].trim() : 'haber taraması') + ek;
  } else if (mm) {
    // Ek yalnız kaynağın adıyla BİREBİR örtüşüyorsa düşer ("… - Dünya" ·
    // kaynak "Dünya Gazetesi"); örtüşmüyorsa başlığın parçası olabilir.
    const ekAd = mm[2].trim().toLocaleLowerCase('tr');
    const kAd = k.replace(/\s*\(\+\d+ kaynak\)$/, '').toLocaleLowerCase('tr');
    if (ekAd.length >= 3 && (kAd.startsWith(ekAd) || ekAd.startsWith(kAd))) baslik = mm[1];
  }
  // İngilizce başlık ekran okuyucuya İngilizce okunsun (sayfa lang="tr").
  const ingilizce = !/[çğıöşüÇĞİÖŞÜ]/.test(baslik)
    && /\b(the|to|of|for|and|on|in|as|with|after|says|sees)\b/i.test(baslik);
  return { baslik, kaynak, lang: ingilizce ? 'en' : undefined };
};
// AYNI HABER BİR KEZ. Bir haber birden çok bölümün süzgecine takılabiliyor
// (30.09'da üç madde iki bölümde birden); yalnız ilk geçtiği bölümde basılır.
// Anahtar bağlantı, yoksa sadeleştirilmiş başlık.
const haberBolumleri = (() => {
  const gorulen = new Set<string>();
  return (b.haberler?.bolumler ?? []).map((bol: any) => ({
    ...bol,
    maddeler: (bol.maddeler ?? []).filter((m: any) => {
      const a = String(m?.baglanti || '').replace(/[?#].*$/, '')
        || String(m?.baslik || '').toLocaleLowerCase('tr').replace(/\W+/g, ' ').trim();
      if (!a || gorulen.has(a)) return !a;
      gorulen.add(a);
      return true;
    }),
  })).filter((bol: any) => bol.maddeler.length > 0 || (b.gundem && b.gundem[bol.id]));
})();
// Kipe bağlı etiketler tek yerde: günlük ve haftaya bakış farklı sözcükler kullanır.
const kip = b.haftalik
  ? { gundemNot: 'Geçen haftanın öne çıkanları: Türkiye ve global taraf, makro ve politika ayrımıyla.' }
  : { gundemNot: 'Dün ve bu sabah öne çıkanlar: Türkiye ve global taraf, makro ve politika ayrımıyla.' };

// Sayı biçimi tek yerden (lib/bicim): eksi işareti U+2212, ondalık virgül,
// yüzde işareti sayının ÖNÜNDE ("−%1,88"), bp sayının ardında ("−6,5 bp").
//
// HANE SÜTUNDA SABİTTİR. Ölçüm katmanı yüzde değişimi iki, baz puanı bir,
// σ'yı bir haneye yuvarlar (bulten/piyasa.py); hane o sözleşmeden okunur.
// `ondalikSay` sayının metin temsilinden sayar ve sondaki sıfırı kaybeder —
// aynı sütunda "−%2,99 · −%2,4 · +%3" basılıyordu ve okur eksik veri sanıyordu.
// Sözleşmesi bilinmeyen birimde kaynağın kendi hanesi korunur.
const HANE: Record<string, number> = { '%': 2, bp: 1 };
const SIGMA_HANE = 1;
const OYNAKLIK_HANE = 2;
const hane = (v: number, birim?: string | null): number => HANE[String(birim ?? '').trim()] ?? ondalikSay(v);
const tr = (v: number | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : sayi(v, ondalik ?? ondalikSay(v));
const isaretli = (v: number | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : sayi(v, ondalik ?? ondalikSay(v), true);
const sigmaYaz = (v: number | null | undefined): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : `${sayi(v, SIGMA_HANE, true)}σ`;
/** Birimli değişim: "%" ise yuzde önde, değilse "sayı birim". */
const degisimli = (v: number | null | undefined, birim: string | null | undefined, ondalik?: number): string =>
  v === null || v === undefined || typeof v !== 'number' ? '—' : degisim(v, birim ?? '', ondalik ?? hane(v, birim));
/** Ölçüm katmanının yazdığı hazır metin: eski sayılarda ASCII tire kalmış olabilir. */
const eksiDuzelt = (s: unknown): string => String(s ?? '').replace(/(^|[\s(])-(?=\d)/g, '$1−');
/**
 * Gösterge farkı. BİR ORANIN FARKI PUANDIR: %31,75'ten %31,51'e inen TÜFE'nin
 * farkı 0,24 puan, %0,24 değil — %0,24'lük bir düşüş 31,75'i 31,67'ye indirirdi.
 * Şerit farkı "−%0,24" basıyordu, aynı sayfadaki olay cümlesi aynı hareketi
 * doğru olarak "puan" diye yazıyordu (ölçüm katmanında `olay.FARK_BIRIMI`).
 */
const gostergeFark = (fark: unknown, birim: unknown, sayisal?: unknown): string => {
  const f = eksiDuzelt(fark);
  const bir = String(birim ?? '').trim();
  // Sıfır fark "—" basılıyordu ve "veri yok" ile karışıyordu.
  if (!f) return sayisal === 0 ? 'değişmedi' : '—';
  if (bir === '%') return `${f} puan`;
  return bir ? `${f} ${bir}` : f;
};
/** Hazır yüzde metni ("21,4", "−1,2") → sözleşme: işaret önde, % sonra ("−%1,2"). */
const yuzdeMetin = (m: unknown): string => {
  const t = eksiDuzelt(m);
  return t.startsWith('−') || t.startsWith('+') ? `${t[0]}%${t.slice(1)}` : `%${t}`;
};
/** Birimli seviye (işaretsiz): "%1,20" ya da "6,5 bp". */
const birimli = (v: number | null | undefined, birim: string | null | undefined, ondalik?: number): string => {
  if (v === null || v === undefined || typeof v !== 'number') return '—';
  const b = (birim ?? '').trim();
  const n = ondalik ?? ondalikSay(v);
  return b === '%' ? yuzde(v, n) : `${sayi(v, n)}${b ? ` ${b}` : ''}`;
};
/** Piyasa satırının son değeri: yüzde birimi ÖNDE ("%5,255"), öbürleri arkada küçük. */
const sonYaz = (r: any): { govde: string; birim: string } => {
  const b = String(r?.birim ?? '').trim();
  if (typeof r?.son !== 'number') return { govde: '—', birim: '' };
  const n = typeof r.ondalik === 'number' ? r.ondalik : ondalikSay(r.son);
  return b === '%' ? { govde: yuzde(r.son, n), birim: '' } : { govde: sayi(r.son, n), birim: b };
};

// ── Künye: sayının ölçülen kimliği
const enstruman = kayit?.enstruman
  ?? (b?.piyasa?.gruplar ?? []).reduce((n: number, g: any) => n + (g?.satirlar?.length ?? 0), 0);
const haberSayisi = kayit?.haber ?? (b?.haberler?.haber?.length ?? 0);
const olcumSaati = kayit?.olcumSaati || istanbulSaat(b.olusturma);

// ── Piyasa fotoğrafının seans dağılımı. "Ölçülen seans" en TAZE satırın
// seansıdır; 23.09.2026 sayısında elli bir satırın yirmi üçü bir seans geride
// olduğu hâlde künye yalnız "22.09.2026 Salı kapanışı" diyordu. Dağılım
// satırların kendi tarihinden sayılır — alanı taşımayan eski sayılarda da.
// Sebep (kaynağın boş verdiği seans · son işlem fiyatından kurulan kapanış)
// yalnız ölçüm katmanı onu yazdıysa söylenir; tahmin edilmez.
const pSatirlar: any[] = (b?.piyasa?.gruplar ?? []).flatMap((g: any) => g?.satirlar ?? []).filter((s: any) => s?.tarih);
const seansSay: [string, number][] = Object.entries(
  pSatirlar.reduce((a: Record<string, number>, s: any) => ((a[s.tarih] = (a[s.tarih] ?? 0) + 1), a), {}),
).sort((x, y) => y[0].localeCompare(x[0])) as [string, number][];
const seansKarma = seansSay.length > 1;
// ANA SEANS satırların ÇOĞUNUN tarihidir, en tazesi değil. 27.09.2026 pazar
// sayısında elli bir satırın ikisi (7/24 işlem gören Bitcoin ve bir kur)
// cumartesi damgalıydı ve künye sayıyı "Cumartesi kapanışı" diye ilan ediyordu;
// kırk dokuz satır cuma kapanışını taşıyordu. Satır içi tarih yalnız ana
// seanstan AYRILAN satırda basılır — elli satırın her birinin altında aynı
// tarihin tekrarı, gerçekten farklı olan tek satırı kalabalıkta gizliyordu.
const anaSeans: string | null = seansSay.length
  ? [...seansSay].sort((x, y) => y[1] - x[1] || y[0].localeCompare(x[0]))[0][0]
  : null;
const anaSeansSay = anaSeans ? (seansSay.find(([t]) => t === anaSeans)?.[1] ?? 0) : 0;
const seansEtiketi = (iso: string): string => `${tarihYaz(iso)} ${gunAdi(iso)} kapanışı`;
// TL faizleri tablosunda da aynı kural: yirmi beş satırın çoğu aynı güne ait;
// tarih yalnız o günden ayrılan satırda yazılır, ortak gün başlıkta.
const tlAnaTarih: string | null = (() => {
  const say: Record<string, number> = {};
  for (const t of b?.piyasa?.tr_faizleri ?? []) if (t?.tarih) say[t.tarih] = (say[t.tarih] ?? 0) + 1;
  const e = Object.entries(say).sort((x, y) => y[1] - x[1] || y[0].localeCompare(x[0]));
  return e.length ? e[0][0] : null;
})();
const kaynakBos: any[] = b?.piyasa?.seans_ozeti?.kaynak_bos ?? [];
const sonIslemden: any[] = b?.piyasa?.seans_ozeti?.son_islemden ?? [];
const adlar = (xs: any[]) => xs.map((x) => x.ad).join(', ');
const gunler = (xs: string[]) => [...new Set(xs)].map((g) => tarihYaz(g)).join(', ');
const manset = duzMetin(String(b.manset ?? '')).trim();
const kunye = [
  // Tek adlandırma: "Sayı 34" (kicker da öyle yazar); künye "No 34" diyordu.
  kayit ? { deger: String(kayit.sayiNo), etiket: 'Sayı', vurgu: true } : null,
  { deger: olcumSaati, etiket: 'Ölçüm', alt: olcumSaati ? 'İstanbul saati' : undefined },
  // Yazı hücresi SAATİ verir: tarih başlıkta zaten yazıyor ve künye aynı günü
  // ikinci kez basıyordu. Saat çözülemezse tarih kalır.
  (b.yazi_zamani || b.yorum_zamani) ? {
    deger: istanbulSaat(b.ilk_yazi_zamani ?? b.yazi_zamani ?? b.yorum_zamani) || tarihUzun(b.yorum_zamani),
    etiket: 'Yazı', alt: 'İstanbul saati',
  } : null,
  { deger: String(enstruman), etiket: 'Enstrüman' },
  haberSayisi ? { deger: String(haberSayisi), etiket: 'Taranan haber' } : null,
  // Değer yalnız TARİH, gün ve satır payı alt satırda: "29.09.2026 Salı
  // kapanışı" tek hücrede üç satıra kırılıyor, künyeyi komşularının üç katı
  // yüksekliğe çıkarıyordu.
  b.piyasa?.kapanis_seansi ? (anaSeans ? {
    deger: tarihYaz(anaSeans), etiket: 'Ölçülen seans',
    alt: `${gunAdi(anaSeans)} kapanışı${seansKarma ? ` · ${anaSeansSay} / ${pSatirlar.length} satır` : ''}`,
  } : { deger: String(b.piyasa.kapanis_seansi), etiket: 'Ölçülen seans' }) : null,
  b.duzeltmeler?.length ? { deger: String(b.duzeltmeler.length), etiket: 'Düzeltme', href: '#duzeltmeler', vurgu: true } : null,
].filter(Boolean) as any[];


// Takvim eskiden iki kez yazılıyordu: "Kritik takvim" birinci derece verilerin
// geri sayımı, "Takvim" ise haftalara bölünmüş tam liste — aynı olay iki
// bölümde birden görünüyordu. Artık tek bölüm: önce geri sayım, sonra tam
// listenin GERİ KALANI. Eşleştirme olay adı + tarih üzerinden yapılır.
//
// "BUGÜN NE VAR" TEK YERDE CEVAPLANIR. Geri sayım yalnız birinci derece
// verileri taşıdığı için aynı sabahın olayları iki listeye bölünüyordu: 10:00'daki
// İşgücü geri sayımda, aynı saatteki Dış ticaret alttaki haftalık tabloda. Bugünün
// BÜTÜN kayıtları (derecesi ne olursa olsun) önce ve saat sırasıyla basılır;
// geri sayım ve haftalık tablolar bugünü tekrar etmez.
const takvimAnahtar = (k: any) => `${k.olay}|${k.tr_tarih}|${k.saat ?? ''}|${k.not_ ?? ''}`;
const bugunIso = String(b.tarih ?? '');
const bugunKayitlar: any[] = [];
{
  const gorulen = new Set<string>();
  const adaylar = [
    ...(b.kritik_takvim ?? []).filter((k: any) => k.kalan_gun === 0 || k.tarih === bugunIso),
    ...(b.takvim ?? []).flatMap((t: any) => t.kayitlar ?? []).filter((k: any) => k.tarih === bugunIso),
  ];
  for (const k of adaylar) {
    const a = takvimAnahtar(k);
    if (!gorulen.has(a)) { gorulen.add(a); bugunKayitlar.push(k); }
  }
  bugunKayitlar.sort((x, y) => String(x.saat || '99:99').localeCompare(String(y.saat || '99:99'))
    || (x.onem ?? 9) - (y.onem ?? 9));
}
const bugunAnahtar = new Set(bugunKayitlar.map(takvimAnahtar));
// Günlük sayıda geri sayım iki haftayla sınırlı; daha ötesi haftalık
// tablolarda kalır (kayıt kaybolmaz). Pazar sayısı ufku olduğu gibi basar.
const KRITIK_UFUK_GUN = 14;
const kritikler = (b.kritik_takvim ?? []).filter((k: any) =>
  !bugunAnahtar.has(takvimAnahtar(k))
  && (b.haftalik || typeof k.kalan_gun !== 'number' || k.kalan_gun <= KRITIK_UFUK_GUN));
const kritikAnahtar = new Set(kritikler.map((k: any) => `${k.olay}|${k.tr_tarih}`));
const takvimGruplari = (b.takvim ?? [])
  .map((t: any) => ({
    ...t,
    kayitlar: t.kayitlar.filter((k: any) =>
      !kritikAnahtar.has(`${k.olay}|${k.tr_tarih}`) && !bugunAnahtar.has(takvimAnahtar(k))),
  }))
  .filter((t: any) => t.kayitlar.length > 0);
const takvimVar = kritikler.length > 0 || takvimGruplari.length > 0;

// AYNI OLAY İKİ BÖLÜMDE ANLATILMAZ — takvimdeki kalıbın eşi, bu kez olaylar için.
// Ölçüldü (07.09.2026, 13 sayı): "Öne çıkanlar" bölümündeki maddeler "Hat hat
// değişim"de BİREBİR tekrar ediyordu. Okur aynı cümleyi iki kez okuyor ve
// ikincisinde yeni bir şey öğrenmiyor.
//
// SÜZGEÇ YALNIZ GERÇEKTEN BASILAN BÖLÜMDEN KURULUR. İlk yazımda küme
// `one_cikanlar` ARTI `notlar`dan kuruluyordu ve üstündeki yorum "notlar
// YUKARIDA duruyor" diyordu — oysa bu bileşende `id="notlar"` diye bir bölüm
// HİÇ OLMADI; `b.notlar` dosyaya ilk kez o commit'le, yalnız bu kümenin içinde
// girdi. Sonuç: `dikkat` seviyesindeki olaylar hem hiçbir yerde basılmıyor hem
// de basıldıkları varsayılarak hat hat listesinden SÜZÜLÜYORDU. Ölçüldü
// (10.09.2026, derlenmiş 17 sayı): 108 dikkat olayının 108'i sayfada yok,
// kontrol olarak 37 önemli olayın 37'si var; 08–10.09 sayılarında
// `one_cikanlar` boş olduğu için okura ölçüm cümlesi HİÇ ulaşmıyordu.
// Bir süzgecin dayandığı varsayım yazıldığı gün ölçülmezse, süzgeç kendi
// gerekçesinden bağımsız olarak yaşamaya devam eder.
//
// `notlar` kovası JSON'da duruyor (denetim ve yazı katmanı onu okuyor) ama
// SAYFANIN tek dikkat-seviyesi evi `gruplar`dır: uret.py o kovaya önemli VE
// dikkat olayların hepsini konu konu yazıyor, yani içerik kaybı yok.
// Anahtar hat+anahtar çifti: aynı ölçüden doğan olay tekildir.
const anilanOlay = new Set(
  (b.one_cikanlar ?? [])
    .filter((o: any) => o?.hat && o?.anahtar)
    .map((o: any) => `${o.hat}|${o.anahtar}`),
);
const gruplarKalan = (b.gruplar ?? [])
  .map((g: any) => ({
    ...g,
    olaylar: (g.olaylar ?? []).filter(
      (o: any) => !(o?.hat && o?.anahtar && anilanOlay.has(`${o.hat}|${o.anahtar}`)),
    ),
  }))
  .filter((g: any) => g.olaylar.length > 0);

// İçindekiler: yalnız GERÇEKTEN basılan bölümler listelenir. Koşulları
// bölümlerin kendi koşullarıyla birebir aynı tutmak şart — yoksa boşa çıkan
// bir bağlantı okuru hiçbir yere götürmez.
// Olağandışılık bölümünün penceresi bültenin kipini izler: günlük bültende gün,
// haftaya bakışta HAFTA. Ölçüm katmanı hangi pencereyi kullandığını
// `en_cok_hareket.sigma_kip` ile söylüyor; başlık ve sütun adları ondan türetilir.
// (Eski sürüm haftalık bültende de "Günün olağandışı hareketleri" yazıyor ve
// haftalık σ'yı "günlük σ" diye etiketliyordu.)
const sigmaHaftalik = b.piyasa?.en_cok_hareket?.sigma_kip === 'haftalik';
const sigmaBaslik = sigmaBasligi(
  (b.piyasa?.en_cok_hareket?.sigma ?? []).map((x: any) => Number(x?.sigma) || 0), sigmaHaftalik);

const bolumler = [
  b.duzeltmeler?.length > 0 && { id: 'duzeltmeler', ad: 'Düzeltmeler' },
  b.ozet && (b.ozet.ne_oldu || b.ozet.ne_bekleniyor) &&
    { id: 'ozet', ad: b.haftalik ? 'Geçen hafta / önümüzdeki hafta' : 'Ne oldu / ne bekleniyor' },
  b.gostergeler?.length > 0 && { id: 'gostergeler', ad: 'Gösterge şeridi' },
  bugunKayitlar.length > 0 && { id: 'bugun', ad: 'Bugün' },
  b.yorum && { id: 'yorum', ad: b.haftalik ? 'Haftanın okuması' : 'Günün okuması' },
  b.rejim?.length > 0 && { id: 'rejim', ad: 'Rejim panosu' },
  b.piyasa?.en_cok_hareket?.sigma?.length > 0 &&
    { id: 'olagandisi', ad: sigmaBaslik },
  b.one_cikanlar?.length > 0 && { id: 'one-cikanlar', ad: 'Öne çıkanlar' },
  b.sonuclar?.length > 0 && { id: 'sonuclar', ad: 'Ne bekleniyordu, ne geldi' },
  b.piyasa?.gruplar?.length > 0 && { id: 'piyasa', ad: 'Piyasa fotoğrafı' },
  gruplarKalan.length > 0 && { id: 'hat-hat', ad: 'Hat hat değişim' },
  (b.izleme?.acik?.length > 0 || b.izleme?.kapanan?.length > 0) &&
    { id: 'soz-defteri', ad: 'Söz defteri' },
  takvimVar && { id: 'takvim', ad: 'Takvim' },
  b.temalar?.temalar?.length > 0 && { id: 'temalar', ad: 'İzlenen temalar' },
  b.haberler?.bolumler?.length > 0 && { id: 'gundem', ad: 'Gündem' },
  b.veri_gunlugu?.length > 0 && { id: 'veri-gunlugu', ad: 'Veri günlüğü' },
].filter(Boolean) as { id: string; ad: string }[];
---

<article class="bulten">
  <header class="ust">
    {/* BAŞLIK = GÜNÜN TEZİ. h1 yalnız tarihti ve tez ancak üçüncü ekranda
        başlıyordu. Yazı katmanı `manset` yazdıysa başlık o cümledir ve tarih
        üstteki etikete iner; yazmadıysa (bütün eski sayılar) başlık tarihtir. */}
    <p class="etiket kicker">
      {b.haftalik ? 'Haftaya bakış' : 'Günlük bülten'}
      {kayit && <span class="kicker-sayi"> · Sayı {kayit.sayiNo}</span>}
      {manset && <span class="kicker-sayi"> · {b.tr_tarih} {b.gun}</span>}
    </p>
    {manset
      ? <h1 class="manset-h1">{manset}</h1>
      : <h1>{b.tr_tarih} <span class="gun">{b.gun}</span></h1>}
    {/* Her sayıda birebir aynı basılan tanıtım paragrafı kaldırıldı: okura o
        sayıya dair hiçbir şey söylemiyordu. Haftalık sayının farkı rozetle kalır. */}
    {b.haftalik && <p class="haftalik-rozet">geçen hafta ve önümüzdeki hafta</p>}
    <Kunye hucreler={kunye} genis etiket="Sayı künyesi" />
    {ayniGun.length > 0 && (
      <ul class="ayni-gun" aria-label="Aynı gün yayımlananlar">
        {ayniGun.map((x) => (
          <li><span class="ag-tur">{x.tur}</span> <a href={x.href}>{x.ad}</a></li>
        ))}
      </ul>
    )}
  </header>

  {/* İKİ SÜTUN. 1360 pikselde bülten 74ch'lik tek sütunda duruyor, sağdaki
      ~460 piksel her ekranda boş kalıyordu; 46 ekranlık bir sayfada okur
      nerede olduğunu ve sıradaki bölümü göremiyordu. Geniş ekranda
      içindekiler sağda yapışık bir sütun, dar ekranda üstte yapışık bir
      bölüm şeridi; etkin bölüm işaretlenir. */}
  <div class="bulten-izgara">
  {bolumler.length > 2 && (
    <nav class="icindekiler" aria-label="Bülten bölümleri">
      <p class="ic-baslik">Bu sayıda</p>
      <ol>
        {bolumler.map((x) => (
          <li><a href={`#${x.id}`}>{x.ad}</a></li>
        ))}
      </ol>
    </nav>
  )}
  <div class="bulten-govde">
  {b.duzeltmeler?.length > 0 && (
    <section class="blok duzeltmeler" id="duzeltmeler">
      <h2>Düzeltmeler</h2>
      <p class="alt-not">
        Daha önce yayımlanan bir sayı yanlış çıktıysa sessizce değiştirilmez: neyin,
        neden ve neye düzeltildiği burada tarihiyle yazar. Bütün yayınların düzeltmeleri
        <a href="/duzeltmeler/">tek listede</a> toplanır.
      </p>
      <ul class="duzeltme-liste">
        {b.duzeltmeler.map((d: any) => (
          <li>
            <span class="d-tarih">{tarihUzun(d.tarih)}</span>
            <span class="d-govde">
              <strong>{d.alan}</strong>
              <span class="d-degerler">
                yayımlanan <s>{d.eski}</s> yerine <b>{d.yeni}</b>
              </span>
              {d.sebep && <span class="d-sebep">{d.sebep}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {b.ozet && (b.ozet.ne_oldu || b.ozet.ne_bekleniyor) && (
    <section class="ozet" id="ozet">
      {b.ozet.ne_oldu && (
        <div class="ozet-parca">
          <h2>{b.haftalik ? 'Geçen hafta ne oldu' : 'Ne oldu'}</h2>
          <div class="ozet-metin" set:html={yaziMetni(b.ozet.ne_oldu)} />
        </div>
      )}
      {b.ozet.ne_bekleniyor && (
        <div class="ozet-parca">
          <h2>{b.haftalik ? 'Önümüzdeki hafta ne bekleniyor' : 'Ne bekleniyor'}</h2>
          <div class="ozet-metin" set:html={yaziMetni(b.ozet.ne_bekleniyor)} />
        </div>
      )}
    </section>
  )}

  {/* ÖNCE SAYILAR. Bileşenin belgesi baştan beri "önce gösterge şeridi"
      diyordu, basım ise ~980 sözcük düzyazıyı şeridin önüne koyuyordu:
      1360×900 ilk ekranda tek bir piyasa sayısı yoktu. */}
  <h2 class="gorunmez">Gösterge şeridi</h2>
  <section class="gosterge-serit" id="gostergeler" aria-label="Gösterge şeridi">
    {b.gostergeler.map((g: any) => (
      <div class="gosterge">
        <span class="g-ad">{g.ad}</span>
        <span class="g-deger">
          {String(g.birim ?? '').trim() === '%'
            ? yuzdeMetin(g.metin)
            : <>{eksiDuzelt(g.metin)}<span class="g-birim">{g.birim}</span></>}
        </span>
        <span class:list={['g-fark', { arti: (g.fark ?? 0) > 0, eksi: (g.fark ?? 0) < 0 }]}>
          {gostergeFark(g.fark_metin, g.birim, g.fark)}
        </span>
        {g.baglam_metin && (
          <span class="g-baglam">
            {g.baglam_ad}{' '}
            {String(g.birim ?? '').trim() === '%'
              ? yuzdeMetin(g.baglam_metin)
              : <>{eksiDuzelt(g.baglam_metin)}<span class="g-birim">{g.birim}</span></>}
          </span>
        )}
        <span class="g-tarih">
          {tz(g.veri_tarihi)}
          {g.kiyas && g.kiyas !== 'son yayım' && <span class="g-kiyas">{g.kiyas}</span>}
        </span>
      </div>
    ))}
  </section>

  {/* "BUGÜN NE VAR" KENDİ BÖLÜMÜ: sabah okurunun üçüncü sorusu takvimin
      içinde, altıncı bölümde kalıyordu. */}
  {bugunKayitlar.length > 0 && (
    <section class="blok kritik-blok" id="bugun">
      <h2>Bugün <span class="adet">{bugunKayitlar.length} kayıt · saatler TSİ</span></h2>
      {bugunKayitlar.length > 0 && (
        <div class="takvim-blok bugun-blok">
          <table class="takvim">
            <caption class="gorunmez">Bugünün takvimi: saat, ülke ve olay</caption>
            <colgroup><col class="c-saat" /><col class="c-ulke" /><col /></colgroup>
            <thead class="gorunmez">
              <tr><th scope="col">saat</th><th scope="col">ülke</th><th scope="col">olay</th></tr>
            </thead>
            <tbody>
              {bugunKayitlar.map((k: any) => (
                <tr class:list={[{ kritik: k.onem === 1 }]}>
                  <td class="t-saat">{k.saat || '—'}</td>
                  <td class="t-ulke">{k.ulke}</td>
                  <td class="t-olay">
                    {k.olay}
                    {k.kesinlik && k.kesinlik !== 'kesin' && <span class="damga">tarih kesinleşmedi</span>}
                    {k.beklenti && <span class="beklenti">{k.beklenti}</span>}
                    {k.not_ && <span class="dipnot">{k.not_}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  )}

  {b.yorum && (
    <section class="yorum" id="yorum">
      {/* Başlık GERÇEK bir h2: ekran okuyucunun başlık listesinde bültenin ilk
          bölümü "Ne oldu" görünüyordu, açılış yazısının başlığı yoktu. */}
      <h2 class="etiket yorum-baslik">{b.haftalik ? 'Haftanın okuması' : 'Günün okuması'}</h2>
      <div set:html={sayiBag(String(b.yorum))} />
    </section>
  )}

  {b.rejim?.length > 0 && (
    <section class="blok rejim" id="rejim">
      <h2>Rejim panosu</h2>
      <details class="yontem"><summary>Yöntem</summary>
        <p>Gösterge şeridi seviyeyi verir; bu pano seviyelerin birlikte ne anlama
        geldiğini. Her satır iki ölçülen büyüklüğün farkıdır ve hesabı yanında
        yazar. Etiketler açıkça yazılmış bir eşikten gelir — okur katılmadığı yerde
        kendi çizgisini çekebilsin diye eşik de görünür.</p>
      </details>
      {/* ANA SAYFAYLA AYNI CETVEL. Aynı veri iki ayrı bileşenle basılıyordu:
          ana sayfada hizalı sütunlar, burada değerin ada yapıştığı bir liste ve
          her satırın altında her gün aynı açıklama paragrafı. Açıklamalar
          katlanır; değerin altında bir önceki sayıya göre fark durur. */}
      <RejimSerit satirlar={rejimSatirlari} />
      {b.rejim.some((r: any) => r.aciklama) && (
        <details class="yontem rejim-anlam"><summary>Satırların anlamı</summary>
          <dl>
            {b.rejim.filter((r: any) => r.aciklama).map((r: any) => (
              <>
                <dt>{r.ad}</dt>
                <dd>{r.aciklama}</dd>
              </>
            ))}
          </dl>
        </details>
      )}
    </section>
  )}

  {b.piyasa.en_cok_hareket?.sigma?.length > 0 && (
    <section class="blok sigma-blok" id="olagandisi">
        <h2>{sigmaBaslik}</h2>
        {/* Sıralama eşiksizdir; başlık eşiği aşan hareket olup olmadığını
            söyler (sigmaBasligi). */}
        {b.piyasa.kapanis_seansi && (
          <p class="alt-not">Ölçülen seans: <strong>{anaSeans ? seansEtiketi(anaSeans) : b.piyasa.kapanis_seansi}</strong>.</p>
        )}
        <details class="yontem"><summary>Yöntem</summary>
          <p>Hareketin büyüklüğü ile olağandışılığı ayrı şeylerdir. Aşağıdaki sıralama
          {sigmaHaftalik
            ? ' haftalık hareketi her enstrümanın kendi son yirmi haftalık oynaklığına bölerek kurulur: σ, o enstrüman için normal bir haftanın ölçüsüdür.'
            : ' günlük hareketi her enstrümanın kendi son yirmi günlük oynaklığına bölerek kurulur: σ, o enstrüman için normal bir günün ölçüsüdür.'}
          Böylece baz puanla yüzde aynı ölçekte kıyaslanır ve yüzdesi küçük ama kendi
          normaline göre büyük hareketler görünür olur. Kapanıştan kapanışa hareket,
          arada hafta sonu ya da tatil olsa da tek seanslık risktir; σ bu yüzden
          boşluğa göre ölçeklenmez.</p>
        </details>
        <SigmaSerit hareketler={b.piyasa.en_cok_hareket.sigma} esik={OLAGANDISI_SIGMA}
                    kip={b.piyasa.en_cok_hareket.sigma_kip} />
        <div class="p-kaydir" tabindex="0" role="region" aria-label="Kaydırılabilir tablo">
          <table class="p-tablo">
            <caption class="gorunmez">En çok hareket edenler: değişim, oynaklık ve kaç standart sapma</caption>
            <thead>
              <tr><th scope="col">Enstrüman</th><th class="sag" scope="col">{sigmaHaftalik ? '1 hafta' : '1 gün'}</th><th class="sag" scope="col">{sigmaHaftalik ? 'Haftalık σ' : 'Günlük σ'}</th><th class="sag" scope="col">Kaç σ</th></tr>
            </thead>
            <tbody>
              {b.piyasa.en_cok_hareket.sigma.map((x: any) => (
                <tr>
                  <td class="p-ad">{x.ad}</td>
                  <td class:list={['sag', 'p-degisim', { arti: x.deger > 0, eksi: x.deger < 0 }]}>
                    {degisimli(x.deger, x.birim)}
                  </td>
                  <td class="sag p-son">{birimli(x.oynaklik, x.birim, OYNAKLIK_HANE)}</td>
                  <td class:list={['sag', 'p-sigma', { olagandisi: Math.abs(x.sigma) >= OLAGANDISI_SIGMA }]}>
                    {sigmaYaz(x.sigma)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
    </section>
  )}

  {b.one_cikanlar.length > 0 && (
    <section class="blok" id="one-cikanlar">
      <h2>Öne çıkanlar</h2>
      <ul class="olay-liste onemli">
        {b.one_cikanlar.map((o: any) => (
          <li>
            <span class="metin">{o.metin}</span>
            {o.aciklama && <span class="dipnot">{o.aciklama}</span>}
            <span class="kaynak-not">{sayfa(o) ? <a href={sayfa(o)!}>{ad(o)}</a> : ad(o)} · veri {tz(o.tarih)}{o.onceki_tarih ? ` (kıyas: ${tz(o.onceki_tarih)})` : ''}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {b.sonuclar?.length > 0 && (
    <section class="blok sonuclar" id="sonuclar">
      <h2>Ne bekleniyordu, ne geldi</h2>
      <details class="yontem"><summary>Yöntem</summary>
        <p>Vakti geçmiş takvim olayları. Beklenti sütunu o gün yayımladığımız
        beklentidir — sonradan güncellenmiş bir anket değil. Sürpriz yalnız sayısal
        bir beklenti varsa hesaplanır; serbest metin beklenti sayıya çevrilmez.
        Piyasa tepkisinin penceresi olayın yaşına göre seçilir ve hücrede yazar.</p>
      </details>
      <ul class="sonuc-liste">
        {b.sonuclar.map((x: any) => (
          <li>
            <div class="sonuc-ust">
              <span class="sonuc-olay">{x.olay}</span>
              <span class="kaynak-not">{tz(x.tarih)}{x.yas_gun > 0 ? ` · ${x.yas_gun} gün önce` : ' · bugün'}</span>
            </div>
            {x.beklenti && <p class="sonuc-beklenti"><strong>Bekleniyordu.</strong> {x.beklenti}</p>}
            {x.durum === 'geldi' ? (
              <p class="sonuc-geldi">
                <strong>Geldi.</strong> {x.ad}: <span class="sonuc-sayi">{tr(x.gerceklesme)}{x.birim && ` ${x.birim}`}</span>
                {x.onceki !== null && x.onceki !== undefined && ` (önceki ${tr(x.onceki)})`}
                {x.surpriz !== null && x.surpriz !== undefined && (
                  <span class:list={['sonuc-surpriz', { arti: x.surpriz > 0, eksi: x.surpriz < 0 }]}>
                    {` sürpriz ${isaretli(x.surpriz)}`}
                  </span>
                )}
                <span class="kaynak-not"> · veri {tz(x.veri_tarihi)}</span>
              </p>
            ) : (
              <p class="sonuc-bekliyor">
                <strong>Henüz yok.</strong> {x.durum}
                {x.veri_tarihi && ` — elimizdeki son veri ${tz(x.veri_tarihi)}`}
              </p>
            )}
            {x.tepki?.kalemler?.length > 0 && (
              <p class="sonuc-tepki">
                <strong>Piyasa ({x.tepki.pencere}).</strong>{' '}
                {x.tepki.kalemler.map((t: any, i: number) => (
                  <>
                    {i > 0 && ' · '}
                    {t.ad}{' '}
                    <span class:list={['sonuc-hareket', { arti: t.deger > 0, eksi: t.deger < 0 }]}>
                      {degisimli(t.deger, t.birim)}
                    </span>
                    {t.sigma !== null && t.sigma !== undefined && ` (${sigmaYaz(t.sigma)})`}
