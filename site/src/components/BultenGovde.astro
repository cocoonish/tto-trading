      ))}
      {b.gundem_yazi_bolumleri && b.gundem_yazi_bolumleri.map((bol: any) => (
        b.gundem && b.gundem[bol.id] ? (
          <div class="gundem-bolum yazi-bolum">
            <h3>{bol.baslik}</h3>
            <div class="gundem-metin" set:html={sayiBag(String(b.gundem[bol.id]))} />
          </div>
        ) : null
      ))}
      {b.haberler.okunamayan.length > 0 && (
        <p class="uyari">Okunamayan kaynak: {b.haberler.okunamayan.join(', ')}</p>
      )}
    </section>
  )}

  {b.veri_gunlugu.length > 0 && (
    <section class="blok" id="veri-gunlugu">
      <h2>Veri günlüğü</h2>
      {/* Gecikme satırları (dikkat) açık ve üstte; "yeni veri" satırları tek
          özet satırının altında katlı — dokuz satırın sekizi her sabah aynı
          biçimde "hat güncellendi" diyordu. */}
      {(() => {
        const dikkat = b.veri_gunlugu.filter((o: any) => o?.seviye === 'dikkat' || o?.seviye === 'onemli');
        const diger = b.veri_gunlugu.filter((o: any) => !(o?.seviye === 'dikkat' || o?.seviye === 'onemli'));
        const satir = (o: any) => (
          <li class:list={[o.seviye]}>
            <span class="metin">{o.metin}</span>
            {o.aciklama && <span class="dipnot">{o.aciklama}</span>}
          </li>
        );
        return (
          <>
            {dikkat.length > 0 && <ul class="olay-liste kucuk">{dikkat.map(satir)}</ul>}
            {diger.length > 0 && (
              <details class="haber-kat">
                <summary>Güncelleme kayıtları · {diger.length}</summary>
                <ul class="olay-liste kucuk">{diger.map(satir)}</ul>
              </details>
            )}
          </>
        );
      })()}
    </section>
  )}

  {/* KAPSAM NOTU sayfanın sonunda tek satır: ne ölçülmediği adıyla, neden
      önemli olduğu katta. Okura yalnız ad ve neden gider; kaydın "aday
      kaynak" ve "engel" alanları veri hattının yapılacaklar listesiydi
      ("çekme ve önbellek yolu yazılacak") ve her sayıda okura basılıyordu. */}
  {b.piyasa.kaynak_yok && b.piyasa.kaynak_yok.length > 0 && (
    <section class="blok kapsam" id="kapsam">
      <p class="kapsam-satir">
        <strong>Bu bültenin ölçmediği büyüklükler:</strong>{' '}
        {b.piyasa.kaynak_yok.map((k: any) => (typeof k === 'string' ? k : k.ad)).join(' · ')}.
        Bültendeki hiçbir yorum bunlara dayanmaz.
      </p>
      {b.piyasa.kaynak_yok.some((k: any) => typeof k !== 'string' && k.neden) && (
        <details class="yontem"><summary>Neden önemliler</summary>
          <dl class="kapsam-liste">
            {b.piyasa.kaynak_yok.filter((k: any) => typeof k !== 'string' && k.neden).map((k: any) => (
              <>
                <dt>{k.ad}</dt>
                <dd>{k.neden}</dd>
              </>
            ))}
          </dl>
        </details>
      )}
    </section>
  )}

  <footer class="kunye">
    <p>
      Ölçüm {istanbulSaat(b.olusturma, 'tam')} İstanbul
      {(b.yazi_zamani || b.yorum_zamani) && ` · yazı ${istanbulSaat(b.yazi_zamani ?? b.yorum_zamani, 'tam') || tarihUzun(b.yorum_zamani)}`}
      {kayit && ` · Sayı ${kayit.sayiNo}`}
    </p>
    <p class="feragat">
      {FERAGAT} Bir büyüklüğün burada yer alması, önceden belirlenmiş bir değişim
      sınırını aştığı anlamına gelir — yorum değil, ölçüm bildirimidir.
    </p>
  </footer>
  </div>
  </div>
</article>

