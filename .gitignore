# macOS
.DS_Store

# Node / Astro
node_modules/
dist/
.astro/

# Python
__pycache__/
*.pyc
.conda/
.ipynb_checkpoints/
.backup_before_refresh/

# Loglar ve yerel önbellekler
*.log

# hazineihrac'ın kendi git geçmişi (devre dışı bırakıldı, silinmedi)
Aktarılacak Projeler/hazineihrac/.git.disabled/

# Büyük, yeniden üretilebilir veri önbellekleri
Aktarılacak Projeler/indices/data/gdelt_cache.json
Aktarılacak Projeler/indices/data/news_cache.json
# EVDS ham yanıt önbellekleri: 12 saatlik TTL ile her koşuda tazelenir, yani her veri
# güncellemesinde yüzlerce dosyalık gürültü diff üretirler ve hepsi yeniden üretilebilir.
# İŞLENMİŞ CSV'ler (data/*.csv) commit'te KALIR — cron'un hafif kipi onlara dayanır.
Aktarılacak Projeler/*/data/cache/

# Yerel Claude ayarları
**/.claude/settings.local.json

# API anahtarları — yerel dosyada durur, ASLA commit edilmez
# (CI'da TTO_EVDS_KEY ortam değişkeni / depo secret'ı kullanılır)
.evds_key
**/.evds_key

# Proje basina sanal ortamlar (bat/*/kur.bat olusturur)
.venv/
**/.venv/
# Yerel doğrulama dosyaları — depoya ve siteye girmez
Aktarılacak Projeler/TCMBNetRezerv/WhatsApp*/
Aktarılacak Projeler/TCMBNetRezerv/kontrol_seti.csv
Aktarılacak Projeler/TCMBNetRezerv/kontrol_ekonomist.csv
Research/marj/data/cache/*.log
gunlukler/
